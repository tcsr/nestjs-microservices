{
  "name": "react19-microservices",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build gateway && nest build products && nest build orders && nest build inventory && nest build payment",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "oxlint apps/ libs/",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "start:gateway": "nest start gateway --watch",
    "start:products": "nest start products --watch",
    "start:orders": "nest start orders --watch",
    "start:inventory": "nest start inventory --watch",
    "start:payment": "nest start payment --watch",
    "start:all": "concurrently -n gateway,products,orders,inventory,payment -c cyan,green,yellow,magenta,blue \"npm:start:gateway\" \"npm:start:products\" \"npm:start:orders\" \"npm:start:inventory\" \"npm:start:payment\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/microservices": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.0.1",
    "@nestjs/websockets": "^12.0.1",
    "kafkajs": "^2.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.2.3",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^10.0.5",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  }
}
